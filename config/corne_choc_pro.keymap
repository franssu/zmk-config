#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen { zmk,physical-layout = &default_layout; };
};

/ {
    combos {
        compatible = "zmk,combos";

        default {
            bindings = <&to 0>;
            key-positions = <12 38 22>;
        };

        mac {
            bindings = <&to 1>;
            key-positions = <8 34 26>;
        };

        kbfeat {
            bindings = <&to 2>;
            key-positions = <1 29 19>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            // --------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |  MUTE |  PP   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |  LALT |  RALT |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |               | ENT | RSE  | ALT |

            bindings = <
&trans  &kp Q  &kp W  &kp E     &kp R      &kp T      &trans  &trans  &kp Y      &kp U      &kp I      &kp O    &kp P     &trans
&trans  &kp A  &kp S  &kp D     &kp F      &kp G      &trans  &trans  &kp H      &kp J      &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z  &kp X  &kp C     &kp V      &kp B                      &kp N      &kp M      &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &kp LALT  &kp SPACE  &kp ENTER                  &kp ENTER  &kp SPACE  &kp RALT
            >;
        };

        layer_mac {
            display-name = "QWERTY";
            bindings = <
&trans  &kp Q  &kp W  &kp E     &kp R      &kp T  &trans  &trans  &kp Y  &kp U      &kp I      &kp O    &kp P     &trans
&trans  &kp A  &kp S  &kp D     &kp F      &kp G  &trans  &trans  &kp H  &kp J      &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z  &kp X  &kp C     &kp V      &kp B                  &kp N  &kp M      &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &kp LCMD  &kp SPACE  &mo 2                  &to 0  &kp SPACE  &kp RCMD
            >;
        };

        kb-feat {
            bindings = <
&trans  &trans  &bl BL_TOG  &bl BL_CYCLE  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &trans  &trans  &trans  &trans  &trans  &trans         &bt BT_CLR      &trans
&trans  &trans  &trans      &trans        &trans           &trans           &trans  &trans  &trans  &trans  &trans  &trans         &bt BT_CLR_ALL  &trans
&trans  &trans  &bt BT_NXT  &trans        &trans           &trans                           &trans  &trans  &trans  &bt BT_DISC 1  &bt BT_DISC 0   &trans
                            &trans        &trans           &trans                           &trans  &trans  &trans
            >;
        };
    };
};
